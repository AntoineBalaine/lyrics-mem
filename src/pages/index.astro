---
import { getCollection } from 'astro:content';
import PrivateLibrary from '../components/PrivateLibrary.astro';
import PublicApp from '../components/PublicApp.astro';

const isPublic = process.env.LYRICS_MODE === 'public';

const songs = isPublic
  ? []
  : (await getCollection('songs')).map((s) => ({
      id: s.id,
      artist: s.data.artist,
      title: s.data.title,
    }));

const base = (import.meta.env.BASE_URL || '/').replace(/\/$/, '');
---

<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width" />
    <title>lyrics-mem</title>
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      rel="stylesheet"
      href="https://fonts.googleapis.com/css2?family=Source+Code+Pro:wght@400;900&display=swap"
    />
  </head>
  <body>
    {isPublic ? <PublicApp /> : <PrivateLibrary songs={songs} base={base} />}
  </body>
</html>
