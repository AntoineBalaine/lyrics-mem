---
import { getCollection, type CollectionEntry } from 'astro:content';
import { applyStep, HTML_STEPS, STEPS, type Step } from '../../../lib/transformations';

export async function getStaticPaths() {
  const songs = await getCollection('songs');
  return songs.flatMap((song) =>
    STEPS.map((step) => ({
      params: { slug: song.id, step: String(step) },
      props: { song, step },
    })),
  );
}

interface Props {
  song: CollectionEntry<'songs'>;
  step: Step;
}

const { song, step } = Astro.props as Props;
const rendered = applyStep(step, song.data.body);
const isHtml = HTML_STEPS.has(step);
const prev = step > 1 ? step - 1 : null;
const next = step < 5 ? step + 1 : null;
---

<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width" />
    <title>{song.data.artist} - {song.data.title} - step {step}</title>
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      rel="stylesheet"
      href="https://fonts.googleapis.com/css2?family=Inter:wght@400;900&display=swap"
    />
  </head>
  <body>
    <p><a href="/">← all songs</a></p>
    <h1>{song.data.artist} — {song.data.title}</h1>
    <nav>
      <span>Step {step} / 5</span>
      {prev !== null && <a href={`/song/${song.id}/${prev}`}>← prev</a>}
      {next !== null && <a href={`/song/${song.id}/${next}`}>next →</a>}
    </nav>
    {isHtml ? <pre set:html={rendered} /> : <pre>{rendered}</pre>}

    <style>
      body {
        max-width: 60ch;
        margin: 2rem auto;
        padding: 0 1rem;
        font-family: system-ui, -apple-system, sans-serif;
        color: #1a1a1a;
      }
      p,
      a {
        font-size: 0.9rem;
      }
      h1 {
        font-size: 1.15rem;
        font-weight: 600;
        margin: 0.75rem 0 0.25rem;
      }
      nav {
        display: flex;
        gap: 1rem;
        align-items: center;
        font-size: 0.9rem;
        margin: 0 0 2rem;
      }
      nav span {
        color: #666;
      }
      pre {
        font-size: 1.15rem;
        line-height: 1.55;
        font-family: 'Inter', system-ui, -apple-system, sans-serif;
        white-space: pre-wrap;
        word-break: break-word;
        margin: 0;
        font-weight: 400;
      }
      pre b {
        font-weight: 900;
      }
    </style>
  </body>
</html>
