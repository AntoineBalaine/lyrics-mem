---
// Chord chart memorizer (proof of concept). Fully client-side: chord
// charts live only in the browser's IndexedDB (see src/lib/chords-db.ts),
// mirroring the lyrics app's public-mode pattern — no server-side DB.
---

<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width" />
    <title>chords-mem</title>
  </head>
  <body>
    <header>
      <h1>chords-mem</h1>
      <p class="tagline">
        A progressive-cloze chord chart memorizer. Paste an iRealPro chart link — charts live in
        your browser only.
      </p>
    </header>

    <section id="view-library">
      <div class="toolbar">
        <input
          id="import-url"
          type="text"
          placeholder="Paste an irealb:// link…"
          autocomplete="off"
        />
        <button id="btn-import" class="primary">Import</button>
      </div>
      <p class="hint">
        No link handy? Try a demo chart:
        <button type="button" class="link" data-demo-index="0">Autumn Leaves</button>,
        <button type="button" class="link" data-demo-index="1">Black Orpheus</button>, or
        <button type="button" class="link" data-demo-index="2">All of Me</button>
      </p>
      <p id="import-status" class="status"></p>

      <div class="toolbar">
        <!-- The input is nested in the label, so the label must not also
             carry a "for" pointing at it: the two together activate the
             picker twice, and on iOS the second activation discards the
             first one's selection. The accept list stays broad because a
             backup file reaches a phone through Files, Drive or Mail,
             which hand it over as octet-stream or plain text as often as
             text/html, and a file the filter greys out cannot be
             chosen at all. -->
        <label class="file-input-label">
          Import iRealPro backup (.html)
          <input
            id="import-backup-file"
            type="file"
            accept=".html,.htm,text/html,text/plain,application/octet-stream"
          />
        </label>
      </div>
      <p id="backup-import-status" class="status"></p>

      <div class="toolbar">
        <input
          id="library-search"
          type="text"
          placeholder="Search charts by title or composer…"
          autocomplete="off"
        />
        <select id="library-sort" aria-label="Sort charts">
          <option value="recent">Recently added</option>
          <option value="title">Title (A-Z)</option>
        </select>
      </div>

      <p id="library-empty" class="empty" hidden>
        No chord charts yet. Paste an iRealPro link above to get started.
      </p>
      <p id="library-no-results" class="empty" hidden>No charts match your search.</p>
      <ul id="library-list" class="library-list"></ul>
      <footer class="lib-footer">
        <span id="library-count"></span>
      </footer>
    </section>

    <section id="view-chart" hidden>
      <div class="chart-toolbar">
        <button id="btn-chart-back" class="link">← Charts</button>
      </div>
      <h2 id="chart-title"></h2>
      <nav class="level-nav">
        <button id="btn-level-prev">← level</button>
        <span>Level <span id="chart-level-num">1</span> / <span id="chart-level-total">5</span></span>
        <button id="btn-level-next">level →</button>
      </nav>
      <nav class="notation-nav" role="group" aria-label="Chord notation">
        <button type="button" data-notation="symbols" aria-pressed="true">Chord symbols</button>
        <button type="button" data-notation="nashville" aria-pressed="false">Nashville numbers</button>
        <button type="button" data-notation="numbers" aria-pressed="false">Number notation</button>
      </nav>
      <p id="chart-meta" class="chart-meta"></p>
      <div class="score-toolbar">
        <span id="copy-status" class="copy-status" aria-live="polite"></span>
        <button id="btn-copy-chart" type="button" class="icon-button" title="Copy chord chart to clipboard" aria-label="Copy chord chart to clipboard">
          <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <rect x="8" y="2" width="8" height="4" rx="1" ry="1"></rect>
            <path d="M16 4h2a2 2 0 0 1 2 2v14a2 2 0 0 1-2 2H6a2 2 0 0 1-2-2V6a2 2 0 0 1 2-2h2"></path>
          </svg>
        </button>
      </div>
      <div id="chart-score"></div>
    </section>

    <script>
      import { boot } from '../../lib/chords-app';
      void boot();
    </script>

    <style is:global>
      body {
        max-width: 70ch;
        margin: 2rem auto;
        padding: 0 1rem 5rem;
        font-family:
          system-ui,
          -apple-system,
          sans-serif;
        color: #1a1a1a;
      }
      header {
        margin-bottom: 1.5rem;
      }
      h1 {
        font-size: 1.4rem;
        font-weight: 600;
        margin: 0;
      }
      h2 {
        font-size: 1.15rem;
        font-weight: 600;
        margin: 0.75rem 0 1rem;
      }
      .chart-meta {
        font-size: 0.85rem;
        color: #666;
        margin: 1rem 0 0;
      }
      .chart-meta span + span::before {
        content: ' · ';
      }
      .tagline {
        font-size: 0.85rem;
        color: #666;
        margin: 0.25rem 0 0;
      }
      .toolbar {
        display: flex;
        gap: 0.5rem;
        margin-bottom: 0.5rem;
      }
      #library-sort {
        padding: 0.5rem 0.75rem;
        font-size: 0.9rem;
        font-family: inherit;
        border: 1px solid #ccc;
        border-radius: 4px;
        background: white;
      }
      .file-input-label {
        display: flex;
        flex-direction: column;
        gap: 0.35rem;
        font-size: 0.85rem;
        color: #666;
      }
      input[type='text'] {
        flex: 1;
        padding: 0.5rem 0.75rem;
        font-size: 1rem;
        box-sizing: border-box;
        border: 1px solid #ccc;
        border-radius: 4px;
        font-family: inherit;
      }
      button {
        font-size: 0.9rem;
        font-family: inherit;
        cursor: pointer;
      }
      button.primary {
        padding: 0.5rem 1rem;
        background: #1a1a1a;
        color: white;
        border: none;
        border-radius: 4px;
        white-space: nowrap;
      }
      button.primary:hover {
        background: #333;
      }
      button.link {
        background: none;
        border: none;
        color: #0066cc;
        padding: 0;
        text-decoration: underline;
      }
      button.link.danger {
        color: #cc0000;
      }
      .hint {
        font-size: 0.85rem;
        color: #666;
        margin: 0.5rem 0;
      }
      .status {
        font-size: 0.85rem;
        color: #b00;
        margin: 0.5rem 0;
        min-height: 1.2em;
      }
      .empty {
        color: #666;
        font-style: italic;
        text-align: center;
        padding: 2rem 0;
      }
      .library-list {
        list-style: none;
        padding: 0;
        margin: 0;
      }
      .library-list li {
        border-bottom: 1px solid #eee;
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 1rem;
      }
      .library-list a.library-item {
        display: flex;
        flex-direction: column;
        padding: 0.6rem 0;
        text-decoration: none;
        color: inherit;
        flex: 1;
      }
      .library-list a.library-item:hover {
        background: #f5f5f5;
      }
      .lib-title {
        font-weight: 600;
      }
      .lib-composer {
        font-size: 0.85rem;
        color: #666;
      }
      .lib-footer {
        display: flex;
        justify-content: space-between;
        align-items: center;
        margin-top: 1.5rem;
        padding-top: 1rem;
        border-top: 1px solid #eee;
        font-size: 0.85rem;
        color: #666;
      }
      .chart-toolbar {
        display: flex;
        justify-content: space-between;
        align-items: center;
        margin-bottom: 0.5rem;
        font-size: 0.9rem;
      }
      .score-toolbar {
        display: flex;
        justify-content: flex-end;
        align-items: center;
        gap: 0.5rem;
        margin-bottom: 0.35rem;
      }
      .icon-button {
        display: inline-flex;
        align-items: center;
        justify-content: center;
        width: 2rem;
        height: 2rem;
        padding: 0;
        border: 1px solid #ccc;
        border-radius: 4px;
        background: white;
        color: #333;
      }
      .icon-button:hover {
        background: #f5f5f5;
      }
      .copy-status {
        font-size: 0.8rem;
        color: #666;
      }
      .level-nav {
        display: flex;
        align-items: center;
        gap: 1rem;
        font-size: 0.9rem;
        color: #666;
        margin: 0 0 1.5rem;
      }
      .level-nav button {
        padding: 0.35rem 0.75rem;
        border: 1px solid #ccc;
        border-radius: 4px;
        background: white;
      }
      .level-nav button:disabled {
        opacity: 0.4;
        cursor: default;
      }
      .notation-nav {
        display: flex;
        gap: 0.5rem;
        margin: 0 0 1.5rem;
      }
      .notation-nav button {
        padding: 0.35rem 0.75rem;
        border: 1px solid #ccc;
        border-radius: 4px;
        background: white;
      }
      .notation-nav button[aria-pressed='true'] {
        background: #1a1a1a;
        color: white;
        border-color: #1a1a1a;
      }
      #chart-score {
        width: 100%;
        box-sizing: border-box;
        overflow-x: auto;
      }
      #chart-score pre {
        font-family: ui-monospace, Menlo, Consolas, monospace;
        white-space: pre-wrap;
      }
      /* One element per line of the chart, never wrapping: a line holds the
         bars a reader expects it to hold, and a narrow screen scrolls
         sideways instead of breaking the grouping. */
      .chart-line {
        display: flex;
        flex-wrap: nowrap;
        align-items: baseline;
        justify-content: space-between;
        width: 100%;
        margin-bottom: 0.6rem;
      }
      .chart-line > * {
        flex-shrink: 0;
      }
      /* Reserves the section letter's width on every line, so that the bars
         of a section's continuation lines stay in the same columns as those
         of the line its letter heads. */
      .chart-line .heading {
        display: inline-flex;
        align-items: center;
        gap: 0.25rem;
      }
      /* Reserves the section letter's width only on a chart that has
         letters, so that a section's continuation lines keep their bars in
         the same columns as the line its letter heads, while a chart with
         no letters at all is not indented for nothing. */
      .chord-grid:has(.section-label) .chart-line .heading {
        min-width: 1.9rem;
      }
      #chart-score .navigation {
        font-size: 0.75rem;
        font-weight: 700;
        color: #1a1a1a;
      }
      #chart-score .error {
        color: #b00;
      }
      #chart-score .time-signature {
        color: #666;
        font-size: 0.85rem;
      }
      #chart-score .ending {
        color: #666;
        font-size: 0.8rem;
        margin-right: 0.2rem;
      }
      #chart-score .annotation {
        color: #666;
        font-size: 0.8rem;
        font-style: italic;
        margin-left: 0.3rem;
      }
      #chart-score .chart-annotation {
        color: #666;
        font-size: 0.85rem;
        margin-bottom: 0.6rem;
      }
      #chart-score .chord-small {
        font-size: 0.85em;
      }
      #chart-score .alternative {
        color: #666;
        font-size: 0.8em;
        font-weight: 500;
      }
      #chart-score .chord {
        font-size: 1.3rem;
        font-weight: 600;
      }
      #chart-score .chord sup {
        font-size: 0.65em;
        font-weight: 500;
        margin-left: 0.05em;
      }
      #chart-score .bar {
        color: #999;
        margin: 0 0.3rem;
      }
      #chart-score .section-label {
        display: inline-flex;
        align-items: center;
        justify-content: center;
        width: 1.5rem;
        height: 1.5rem;
        margin-right: 0.4rem;
        border: 1px solid #1a1a1a;
        border-radius: 3px;
        font-size: 0.9rem;
        font-weight: 700;
        flex-shrink: 0;
      }
    </style>
  </body>
</html>
