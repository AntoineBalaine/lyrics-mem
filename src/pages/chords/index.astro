---
// Chord chart memorizer (proof of concept). Fully client-side: chord
// charts live only in the browser's IndexedDB (see src/lib/chords-db.ts),
// mirroring the lyrics app's public-mode pattern — no server-side DB.

// Trimmed of its trailing slash so the links below can add their own,
// which is the same convention src/pages/index.astro uses.
const base = (import.meta.env.BASE_URL || '/').replace(/\/$/, '');
---

<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width" />
    <title>chords-mem</title>
  </head>
  <body>
    <header>
      <h1>chords-mem</h1>
      <p class="tagline">
        A progressive-cloze chord chart memorizer. Paste an iRealPro chart link — charts live in
        your browser only.
      </p>
      <p class="app-nav">Also check out <a href={`${base}/`}>lyrics-mem</a></p>
    </header>

    <section id="view-library">
      <div class="toolbar">
        <input
          id="import-url"
          type="text"
          placeholder="Paste an irealb:// link…"
          autocomplete="off"
        />
        <button id="btn-import" class="primary">Import</button>
      </div>
      <p class="hint">
        No link handy? Try a demo chart:
        <button type="button" class="link" data-demo-index="0">All of Me</button>
      </p>
      <p id="import-status" class="status"></p>

      <div class="toolbar">
        <!-- The input is nested in the label, so the label must not also
             carry a "for" pointing at it: the two together activate the
             picker twice, and on iOS the second activation discards the
             first one's selection. The accept list stays broad because a
             backup file reaches a phone through Files, Drive or Mail,
             which hand it over as octet-stream or plain text as often as
             text/html, and a file the filter greys out cannot be
             chosen at all. -->
        <label class="file-input-label">
          Import iRealPro backup (.html)
          <input
            id="import-backup-file"
            type="file"
            accept=".html,.htm,text/html,text/plain,application/octet-stream"
          />
        </label>
      </div>
      <p id="backup-import-status" class="status"></p>

      <div class="toolbar">
        <!-- The clear button sits inside the field's own box rather than
             beside it, so that it reads as part of the field and does not
             take width from the field on a narrow screen. It is hidden
             while the field is empty, since there is then nothing to
             clear. -->
        <div class="search-field">
          <input
            id="library-search"
            type="text"
            placeholder="Search charts by title or composer…"
            autocomplete="off"
          />
          <button
            id="btn-clear-search"
            type="button"
            class="clear-button"
            title="Clear the search"
            aria-label="Clear the search"
            hidden
          >
            <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
              <line x1="18" y1="6" x2="6" y2="18"></line>
              <line x1="6" y1="6" x2="18" y2="18"></line>
            </svg>
          </button>
        </div>
        <select id="library-sort" aria-label="Sort charts">
          <option value="recent">Recently added</option>
          <option value="title">Title (A-Z)</option>
        </select>
      </div>

      <p id="library-empty" class="empty" hidden>
        No chord charts yet. Paste an iRealPro link above to get started.
      </p>
      <p id="library-no-results" class="empty" hidden>No charts match your search.</p>
      <ul id="library-list" class="library-list"></ul>
      <footer class="lib-footer">
        <span id="library-count"></span>
      </footer>
    </section>

    <section id="view-chart" hidden>
      <div class="chart-toolbar">
        <button id="btn-chart-back" class="link">← Charts</button>
      </div>
      <h2 id="chart-title"></h2>
      <nav class="level-nav">
        <button id="btn-level-prev">← level</button>
        <span>Level <span id="chart-level-num">1</span> / <span id="chart-level-total">5</span></span>
        <button id="btn-level-next">level →</button>
      </nav>
      <nav class="notation-nav" role="group" aria-label="Chord notation">
        <button type="button" data-notation="symbols" aria-pressed="true">Chord symbols</button>
        <button type="button" data-notation="nashville" aria-pressed="false">Nashville numbers</button>
        <button type="button" data-notation="numbers" aria-pressed="false">Number notation</button>
      </nav>
      <p id="chart-meta" class="chart-meta"></p>
      <div class="score-toolbar">
        <span id="copy-status" class="copy-status" aria-live="polite"></span>
        <button id="btn-copy-chart" type="button" class="icon-button" title="Copy chord chart to clipboard" aria-label="Copy chord chart to clipboard">
          <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <rect x="8" y="2" width="8" height="4" rx="1" ry="1"></rect>
            <path d="M16 4h2a2 2 0 0 1 2 2v14a2 2 0 0 1-2 2H6a2 2 0 0 1-2-2V6a2 2 0 0 1 2-2h2"></path>
          </svg>
        </button>
      </div>
      <div id="chart-score"></div>
    </section>

    <script>
      import { boot } from '../../lib/chords-app';
      void boot();
    </script>

    <style is:global>
      body {
        /* The side padding is a variable so that anything needing the full
           width can cancel it exactly rather than guess at it. */
        --gutter: 0.5rem;
        max-width: 70ch;
        margin: 2rem auto;
        padding: 0 var(--gutter) 5rem;
        font-family:
          system-ui,
          -apple-system,
          sans-serif;
        color: #1a1a1a;
      }
      header {
        margin-bottom: 1.5rem;
      }
      h1 {
        font-size: 1.4rem;
        font-weight: 600;
        margin: 0;
      }
      h2 {
        font-size: 1.15rem;
        font-weight: 600;
        margin: 0.75rem 0 1rem;
      }
      .chart-meta {
        font-size: 0.85rem;
        color: #666;
        margin: 1rem 0 0;
      }
      .chart-meta span + span::before {
        content: ' · ';
      }
      .tagline {
        font-size: 0.85rem;
        color: #666;
        margin: 0.25rem 0 0;
      }
      .toolbar {
        display: flex;
        gap: 0.5rem;
        margin-bottom: 0.5rem;
      }
      #library-sort {
        padding: 0.5rem 0.75rem;
        font-size: 0.9rem;
        font-family: inherit;
        border: 1px solid #ccc;
        border-radius: 4px;
        background: white;
      }
      .app-nav {
        text-align: right;
        font-size: 0.85rem;
        color: #888;
        margin: 0.35rem 0 0;
      }
      .file-input-label {
        display: flex;
        flex-direction: column;
        gap: 0.35rem;
        font-size: 0.85rem;
        color: #666;
      }
      .search-field {
        position: relative;
        display: flex;
        flex: 1;
        align-items: center;
      }
      .search-field input[type='text'] {
        /* Room for the clear button, so a long query does not run under it. */
        padding-right: 2.25rem;
      }
      .clear-button {
        position: absolute;
        right: 0.4rem;
        display: inline-flex;
        align-items: center;
        justify-content: center;
        padding: 0.25rem;
        border: none;
        background: none;
        color: #999;
        cursor: pointer;
        line-height: 0;
      }
      .clear-button:hover {
        color: #1a1a1a;
      }
      input[type='text'] {
        flex: 1;
        padding: 0.5rem 0.75rem;
        font-size: 1rem;
        box-sizing: border-box;
        border: 1px solid #ccc;
        border-radius: 4px;
        font-family: inherit;
      }
      button {
        font-size: 0.9rem;
        font-family: inherit;
        cursor: pointer;
      }
      button.primary {
        padding: 0.5rem 1rem;
        background: #1a1a1a;
        color: white;
        border: none;
        border-radius: 4px;
        white-space: nowrap;
      }
      button.primary:hover {
        background: #333;
      }
      button.link {
        background: none;
        border: none;
        color: #0066cc;
        padding: 0;
        text-decoration: underline;
      }
      button.link.danger {
        color: #cc0000;
      }
      .hint {
        font-size: 0.85rem;
        color: #666;
        margin: 0.5rem 0;
      }
      .status {
        font-size: 0.85rem;
        color: #b00;
        margin: 0.5rem 0;
        min-height: 1.2em;
      }
      .empty {
        color: #666;
        font-style: italic;
        text-align: center;
        padding: 2rem 0;
      }
      .library-list {
        list-style: none;
        padding: 0;
        margin: 0;
      }
      .library-list li {
        border-bottom: 1px solid #eee;
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 1rem;
      }
      .library-list a.library-item {
        display: flex;
        flex-direction: column;
        padding: 0.6rem 0;
        text-decoration: none;
        color: inherit;
        flex: 1;
      }
      .library-list a.library-item:hover {
        background: #f5f5f5;
      }
      .lib-title {
        font-weight: 600;
      }
      .lib-composer {
        font-size: 0.85rem;
        color: #666;
      }
      .lib-footer {
        display: flex;
        justify-content: space-between;
        align-items: center;
        margin-top: 1.5rem;
        padding-top: 1rem;
        border-top: 1px solid #eee;
        font-size: 0.85rem;
        color: #666;
      }
      .chart-toolbar {
        display: flex;
        justify-content: space-between;
        align-items: center;
        margin-bottom: 0.5rem;
        font-size: 0.9rem;
      }
      .score-toolbar {
        display: flex;
        justify-content: flex-end;
        align-items: center;
        gap: 0.5rem;
        margin-bottom: 0.35rem;
      }
      .icon-button {
        display: inline-flex;
        align-items: center;
        justify-content: center;
        width: 2rem;
        height: 2rem;
        padding: 0;
        border: 1px solid #ccc;
        border-radius: 4px;
        background: white;
        color: #333;
      }
      .icon-button:hover {
        background: #f5f5f5;
      }
      .copy-status {
        font-size: 0.8rem;
        color: #666;
      }
      .level-nav {
        display: flex;
        align-items: center;
        gap: 1rem;
        font-size: 0.9rem;
        color: #666;
        margin: 0 0 1.5rem;
      }
      .level-nav button {
        padding: 0.35rem 0.75rem;
        border: 1px solid #ccc;
        border-radius: 4px;
        background: white;
      }
      .level-nav button:disabled {
        opacity: 0.4;
        cursor: default;
      }
      .notation-nav {
        display: flex;
        gap: 0.5rem;
        margin: 0 0 1.5rem;
      }
      .notation-nav button {
        padding: 0.35rem 0.75rem;
        border: 1px solid #ccc;
        border-radius: 4px;
        background: white;
      }
      .notation-nav button[aria-pressed='true'] {
        background: #1a1a1a;
        color: white;
        border-color: #1a1a1a;
      }
      /* A chart is the one thing here that is not prose, so it takes the
         whole screen rather than the reading column. It cancels the body's
         gutter and its own share of the 70ch cap, which is what was
         keeping a four-bar line narrower than the phone it was on. */
      #view-chart {
        width: 100vw;
        margin-left: calc(50% - 50vw);
        padding: 0 var(--gutter);
        box-sizing: border-box;
      }
      #chart-score {
        width: 100%;
        box-sizing: border-box;
      }
      #chart-score pre {
        font-family: ui-monospace, Menlo, Consolas, monospace;
        white-space: pre-wrap;
      }
      /* A line is a grid rather than a row sized by its contents, which is
         how iReal Pro always fits a screen exactly: a barline takes only
         the width it needs and the bars share what is left in equal parts,
         so the line is the container's width by construction. Sizing by
         content is what pushed a line holding D7b9#5 past the edge of a
         phone. The template reads as the leading barline, then a bar and
         its closing barline repeated once per bar, which is why an ending
         number sits inside its bar rather than between the two. */
      .chart-line {
        display: grid;
        grid-template-columns: auto repeat(var(--bars, 4), minmax(0, 1fr) auto);
        align-items: start;
        column-gap: 0.15rem;
        width: 100%;
        margin-bottom: 0.6rem;
      }
      /* A section's letter and meter, on their own line above the chords. */
      .chart-heading {
        display: flex;
        align-items: center;
        gap: 0.3rem;
        margin-bottom: 0.15rem;
      }
      /* A bar is a column: chords on the first row, whatever is written
         about the bar on a second row beneath them. */
      .bar-stack {
        display: flex;
        flex-direction: column;
        align-items: stretch;
        min-width: 0;
      }
      /* What is written under a bar must not widen it. The bar's share of
         the line is already fixed, so the text wraps inside that share and
         breaks mid-word if a single word is wider than the bar; without
         this its unbroken width pushed past the bar's share, overflowed the
         line and put a horizontal scrollbar on the chart. A longer note
         makes its line taller, which costs nothing, rather than making the
         chart wider, which breaks the fitting. */
      .bar-stack .under {
        line-height: 1.1;
        min-width: 0;
        white-space: normal;
        overflow-wrap: anywhere;
      }
      /* The bar's own cells, so a chord sits where the chart put it: one
         chord of a pair on the first cell of four starts at the bar's left
         edge and holds half of it, and its partner on the third starts
         halfway. */
      .measure {
        display: grid;
        grid-template-columns: repeat(var(--cells, 1), minmax(0, 1fr));
        align-items: baseline;
        min-width: 0;
      }
      .measure > .cell {
        grid-column: var(--cell-at, auto) / span var(--cell-span, 1);
        min-width: 0;
      }
      /* Text shrinks to fit its cell rather than widening it, which is what
         iReal Pro does with a crowded bar; a cell that grew would stop the
         bars being equal shares. The size is taken from the cell rather
         than from the line, so a chord sharing a bar with another shrinks
         further than one holding the bar alone, which is the whole point.
         CSS cannot measure text, so this is proportional rather than exact:
         the factor is set so that the longest chord names in a real
         library, seven or eight characters, fit a quarter-line bar on a
         narrow phone. */

      #chart-score .navigation {
        font-size: 0.75rem;
        font-weight: 700;
        color: #1a1a1a;
      }
      #chart-score .error {
        color: #b00;
      }
      #chart-score .time-signature {
        color: #666;
        font-size: 0.85rem;
      }
      /* A repeat's number stands above its bar without taking a row from
         it. Because it was a row of the bar's own column, a bar with an
         ending had its chords pushed below those of the bars beside it,
         and the number read as part of the bar. Here it is taken out of the
         flow and placed over the bar's top edge, and a line holding one
         reserves the strip it occupies. A fixed size keeps it out of the
         shrinking that applies to a chord. */
      .bar-stack {
        position: relative;
      }
      .chart-line.has-ending {
        padding-top: 1rem;
      }
      #chart-score .ending {
        position: absolute;
        bottom: 100%;
        left: 0;
        color: #666;
        font-size: 0.8rem;
        line-height: 1.1;
        white-space: nowrap;
      }
      #chart-score .annotation {
        color: #666;
        font-size: 0.8rem;
        font-style: italic;
      }
      /* Colour by chord quality. Only the four families asked for are
         coloured; anything else keeps the body colour rather than being
         given a meaning by implication. Chosen dark enough to stay legible
         on white at the superscript sizes the qualities are set in. */
      #chart-score .quality-dominant {
        color: #b3261e;
      }
      #chart-score .quality-minor {
        color: #1a4fb4;
      }
      #chart-score .quality-major {
        color: #1b6b3a;
      }
      #chart-score .quality-half-diminished {
        color: #6b3fa0;
      }
      #chart-score .chart-annotation {
        color: #666;
        font-size: 0.85rem;
        margin-bottom: 0.6rem;
      }
      #chart-score .alternative {
        color: #666;
        font-size: 0.8em;
        font-weight: 500;
      }
      /* The chord's size has to be declared here rather than on a selector
         naming its cell, and that is the whole of why three attempts at
         this did nothing: this rule carries an id, so it outranks any
         selector built from classes however specific it looks, and a
         `font-size: 1.3rem` sitting here quietly beat every clamp written
         elsewhere. Changing the units was never going to help.
         
         The renderer works out the largest size at which this cell's text
         fits the width the grid gives it, from the text's own length and the
         cell's share of the screen, and passes it as --fit in viewport
         units. That is only a first guess, because it cannot know the real
         width of a glyph or of a barline, so src/lib/chord-fit.ts measures
         each chord in the browser and replaces --fit with a size that fits.
         The floor is low for that reason: a higher one would bring back the
         overflow it was meant to prevent. */
      #chart-score .chord {
        display: block;
        white-space: nowrap;
        font-weight: 600;
        --size: clamp(0.3rem, var(--fit, 1.3rem), 1.3rem);
        font-size: var(--size);
      }
      /* A cue-sized chord is a fraction of whatever size its cell allows,
         not a fixed size of its own. It has to come after the rule above
         and carry the same id, or it loses the cascade to it the way that
         rule used to beat the clamp. */
      #chart-score .chord-small {
        font-size: calc(0.85 * var(--size));
      }
      #chart-score .chord sup {
        font-size: 0.65em;
        font-weight: 500;
        margin-left: 0.05em;
      }
      #chart-score .bar {
        color: #999;
        margin: 0 0.3rem;
      }
      #chart-score .section-label {
        display: inline-flex;
        align-items: center;
        justify-content: center;
        width: 1.5rem;
        height: 1.5rem;
        margin-right: 0.4rem;
        border: 1px solid #1a1a1a;
        border-radius: 3px;
        font-size: 0.9rem;
        font-weight: 700;
        flex-shrink: 0;
      }
    </style>
  </body>
</html>
